# Local Postgres runtime URL. The app role is deliberately not a superuser so RLS applies.
DATABASE_URL="postgresql://routewise_app:routewise_app_dev@localhost:5432/routewise?schema=public"
# Use only for schema migrations and seeding. Never configure this in the API runtime.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/routewise?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-this-with-at-least-32-random-characters"
OTP_HMAC_SECRET="replace-this-with-a-different-32-character-secret"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Routewise <hello@routewise.local>"
# Demo fixtures are disabled unless both explicit opt-ins are supplied.
ALLOW_DEMO_SEED="false"
DEMO_SEED_PASSWORD=""
