{
  "name": "@routewise/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint src prisma scripts test --max-warnings=0",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prisma-command.ts migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test:tenant-isolation": "tsx test/tenant-isolation.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@routewise/shared": "workspace:*",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "eslint": "^8.57.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
